<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Color Scheme & Brushes -->
    <Color x:Key="ColorObsidian">#0c0f17</Color>
    <Color x:Key="ColorObsidianGlass">#cc0c0f17</Color>
    <Color x:Key="ColorNeonCyan">#00f0ff</Color>
    <Color x:Key="ColorNeonViolet">#9d00ff</Color>
    <Color x:Key="ColorNeonMagenta">#ff007f</Color>
    
    <SolidColorBrush x:Key="BrushObsidian" Color="{StaticResource ColorObsidian}"/>
    <SolidColorBrush x:Key="BrushObsidianGlass" Color="{StaticResource ColorObsidianGlass}"/>
    <SolidColorBrush x:Key="BrushNeonCyan" Color="{StaticResource ColorNeonCyan}"/>
    <SolidColorBrush x:Key="BrushNeonViolet" Color="{StaticResource ColorNeonViolet}"/>
    <SolidColorBrush x:Key="BrushNeonMagenta" Color="{StaticResource ColorNeonMagenta}"/>
    
    <SolidColorBrush x:Key="BrushTextPrimary" Color="#e4e6eb"/>
    <SolidColorBrush x:Key="BrushTextSecondary" Color="#b0b3b8"/>
    <SolidColorBrush x:Key="BrushTextMuted" Color="#65676b"/>
    
    <SolidColorBrush x:Key="BrushBorderGlass" Color="#15ffffff"/>
    <SolidColorBrush x:Key="BrushBorderActive" Color="#559d00ff"/>
    <SolidColorBrush x:Key="BrushCardBackground" Color="#08ffffff"/>
    
    <!-- Neon Linear Gradients -->
    <LinearGradientBrush x:Key="BrushNeonGradient" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="{StaticResource ColorNeonViolet}" Offset="0.0"/>
        <GradientStop Color="{StaticResource ColorNeonMagenta}" Offset="1.0"/>
    </LinearGradientBrush>

