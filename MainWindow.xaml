<Window x:Class="audio_mixer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="KilrKrow Audio Mixer"
        Width="380"
        Height="540"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        Deactivated="Window_Deactivated">
    
    <Window.Resources>
        <!-- Window Slide and Fade Animations -->
        <Storyboard x:Key="SlideUp">
            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                             From="0.0" To="1.0" Duration="0:0:0.25">
                <DoubleAnimation.EasingFunction>
                    <CircleEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetProperty="Top"
                             Duration="0:0:0.25">
                <DoubleAnimation.EasingFunction>
                    <CircleEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
        <Storyboard x:Key="SlideDown">
            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                             From="1.0" To="0.0" Duration="0:0:0.2">
                <DoubleAnimation.EasingFunction>
                    <CircleEase EasingMode="EaseIn"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetProperty="Top"
                             Duration="0:0:0.2">
                <DoubleAnimation.EasingFunction>
                    <CircleEase EasingMode="EaseIn"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
    </Window.Resources>

    <Grid Margin="10">
        <!-- Main Window Glass Container -->
        <Border x:Name="WindowBorder"
                CornerRadius="16"
                Background="#df0c0f17"
                BorderBrush="#25ffffff"
                BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect Color="#000000" BlurRadius="15" ShadowDepth="2" Opacity="0.5"/>
            </Border.Effect>
            
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="50"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Titlebar Area -->
                <Grid Grid.Row="0" Margin="16,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="KILRKROW"
                                   Foreground="{StaticResource BrushNeonCyan}"
                                   FontFamily="Segoe UI Semibold, Inter"
                                   FontSize="11"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text=" MIXER"
                                   Foreground="{StaticResource BrushTextPrimary}"
                                   FontFamily="Segoe UI Semibold, Inter"
                                   FontSize="11"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Header Navigation Buttons -->
                    <Button x:Name="BtnNav"
                            Grid.Column="1"
                            Style="{StaticResource GlassIconButton}"
                            Margin="0,0,6,0"
                            Click="BtnNav_Click">
                        <Path x:Name="PathNav"
                              Data="{StaticResource IconSettings}"
                              Fill="{StaticResource BrushTextSecondary}"
                              Width="14"
                              Height="14"
                              Stretch="Uniform"/>
                    </Button>

                    <Button Grid.Column="2"
                            Style="{StaticResource GlassIconButton}"
                            Click="BtnClose_Click">
                        <Path Data="{StaticResource IconClose}"
                              Fill="{StaticResource BrushTextSecondary}"
                              Width="14"
                              Height="14"
                              Stretch="Uniform"/>
                    </Button>
                </Grid>

                <Separator Grid.Row="0" Height="1" Background="#15ffffff" VerticalAlignment="Bottom"/>

                <!-- Content Panel (Dynamic Toggle Panels) -->
                <Grid Grid.Row="1" Margin="16,12">
                    
                    <!-- 1. MIXER SCREEN -->
                    <Grid x:Name="PanelMixer" Visibility="Visible">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/> <!-- Devices Selector -->
                            <RowDefinition Height="*"/>    <!-- Session Volume Sliders -->
                        </Grid.RowDefinitions>

                        <!-- Audio Devices Section -->
                        <Border Grid.Row="0"
                                Background="{StaticResource BrushCardBackground}"
                                BorderBrush="{StaticResource BrushBorderGlass}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="12"
                                Margin="0,0,0,12">
                            <StackPanel>
                                <!-- Playback Device Selection -->
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Path Grid.Column="0" Data="{StaticResource IconVolume}" Fill="{StaticResource BrushNeonCyan}" Width="16" Height="16" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <ComboBox x:Name="ComboPlayback"
                                              Grid.Column="1"
                                              Background="#15000000"
                                              Foreground="{StaticResource BrushTextPrimary}"
                                              BorderBrush="{StaticResource BrushBorderGlass}"
                                              Padding="8,6"
                                              SelectionChanged="ComboPlayback_SelectionChanged"
                                              VerticalAlignment="Center"/>
                                    <CheckBox x:Name="CheckFavPlayback"
                                              Grid.Column="2"
                                              Style="{StaticResource FavoriteCheckBox}"
                                              Margin="8,0,0,0"
                                              VerticalAlignment="Center"
                                              Checked="CheckFavPlayback_Changed"
                                              Unchecked="CheckFavPlayback_Changed"/>
                                </Grid>

                                <!-- Microphone Device Selection -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Path Grid.Column="0" Data="{StaticResource IconMic}" Fill="{StaticResource BrushNeonMagenta}" Width="16" Height="16" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <ComboBox x:Name="ComboRecording"
                                              Grid.Column="1"
                                              Background="#15000000"
                                              Foreground="{StaticResource BrushTextPrimary}"
                                              BorderBrush="{StaticResource BrushBorderGlass}"
                                              Padding="8,6"
                                              SelectionChanged="ComboRecording_SelectionChanged"
                                              VerticalAlignment="Center"/>
                                    <CheckBox x:Name="CheckFavRecording"
                                              Grid.Column="2"
                                              Style="{StaticResource FavoriteCheckBox}"
                                              Margin="8,0,0,0"
                                              VerticalAlignment="Center"
                                              Checked="CheckFavRecording_Changed"
                                              Unchecked="CheckFavRecording_Changed"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Scrollable App Mixer List -->
                        <Grid Grid.Row="1">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <StackPanel x:Name="ListAppSessions" Margin="0,0,4,0"/>
                            </ScrollViewer>
                        </Grid>
                    </Grid>

                    <!-- 2. SETTINGS SCREEN -->
                    <Grid x:Name="PanelSettings" Visibility="Collapsed">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Margin="0,0,4,0">
                                
                                <!-- Favorite Devices Summary -->
                                <TextBlock Text="FAVORITE DEVICES" Foreground="{StaticResource BrushTextSecondary}" FontSize="10" FontFamily="Segoe UI Semibold, Inter" Margin="0,0,0,8"/>
                                <Border Background="{StaticResource BrushCardBackground}" BorderBrush="{StaticResource BrushBorderGlass}" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,0,16">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Playback: " Foreground="{StaticResource BrushTextSecondary}" FontSize="11" Width="60"/>
                                            <TextBlock x:Name="TxtFavPlaybackName" Grid.Column="1" Text="None Selected" Foreground="{StaticResource BrushTextPrimary}" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                        </Grid>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Mic: " Foreground="{StaticResource BrushTextSecondary}" FontSize="11" Width="60"/>
                                            <TextBlock x:Name="TxtFavRecordingName" Grid.Column="1" Text="None Selected" Foreground="{StaticResource BrushTextPrimary}" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- Global Hotkey Configuration -->
                                <TextBlock Text="GLOBAL HOTKEYS" Foreground="{StaticResource BrushTextSecondary}" FontSize="10" FontFamily="Segoe UI Semibold, Inter" Margin="0,0,0,8"/>
                                <Border Background="{StaticResource BrushCardBackground}" BorderBrush="{StaticResource BrushBorderGlass}" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,0,16">
                                    <StackPanel>
                                        <!-- Hotkey: Toggle Mixer -->
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="140"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Toggle Mixer UI" Foreground="{StaticResource BrushTextPrimary}" FontSize="11" VerticalAlignment="Center"/>
                                            <TextBox x:Name="TxtHotkeyToggleMixer" Grid.Column="1" Background="#15000000" Foreground="{StaticResource BrushTextPrimary}" BorderBrush="{StaticResource BrushBorderGlass}" Padding="6,4" FontSize="11" HorizontalContentAlignment="Center" IsReadOnly="True" Cursor="Hand" PreviewKeyDown="HotkeyTextBox_PreviewKeyDown"/>
                                        </Grid>

                                        <!-- Hotkey: Switch Output -->
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="140"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Switch to Favorite Out" Foreground="{StaticResource BrushTextPrimary}" FontSize="11" VerticalAlignment="Center"/>
                                            <TextBox x:Name="TxtHotkeyFavOutput" Grid.Column="1" Background="#15000000" Foreground="{StaticResource BrushTextPrimary}" BorderBrush="{StaticResource BrushBorderGlass}" Padding="6,4" FontSize="11" HorizontalContentAlignment="Center" IsReadOnly="True" Cursor="Hand" PreviewKeyDown="HotkeyTextBox_PreviewKeyDown"/>
                                        </Grid>

                                        <!-- Hotkey: Switch Input -->
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="140"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Switch to Favorite Mic" Foreground="{StaticResource BrushTextPrimary}" FontSize="11" VerticalAlignment="Center"/>
                                            <TextBox x:Name="TxtHotkeyFavInput" Grid.Column="1" Background="#15000000" Foreground="{StaticResource BrushTextPrimary}" BorderBrush="{StaticResource BrushBorderGlass}" Padding="6,4" FontSize="11" HorizontalContentAlignment="Center" IsReadOnly="True" Cursor="Hand" PreviewKeyDown="HotkeyTextBox_PreviewKeyDown"/>
                                        </Grid>

                                        <!-- Hotkey: Reset Levels -->
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="140"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Reset Volume Presets" Foreground="{StaticResource BrushTextPrimary}" FontSize="11" VerticalAlignment="Center"/>
                                            <TextBox x:Name="TxtHotkeyResetLevels" Grid.Column="1" Background="#15000000" Foreground="{StaticResource BrushTextPrimary}" BorderBrush="{StaticResource BrushBorderGlass}" Padding="6,4" FontSize="11" HorizontalContentAlignment="Center" IsReadOnly="True" Cursor="Hand" PreviewKeyDown="HotkeyTextBox_PreviewKeyDown"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- App Volume Presets Section -->
                                <TextBlock Text="FAVORITE VOLUME PRESETS" Foreground="{StaticResource BrushTextSecondary}" FontSize="10" FontFamily="Segoe UI Semibold, Inter" Margin="0,0,0,8"/>
                                <Border Background="{StaticResource BrushCardBackground}" BorderBrush="{StaticResource BrushBorderGlass}" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,0,8">
                                    <StackPanel>
                                        <!-- Preset App List Container -->
                                        <StackPanel x:Name="ListPresetsContainer" Margin="0,0,0,10"/>
                                        
                                        <!-- Row to Add Active App to Presets -->
                                        <Separator Height="1" Background="#15ffffff" Margin="0,0,0,10"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <ComboBox x:Name="ComboAddPreset" Grid.Column="0" Background="#15000000" Foreground="{StaticResource BrushTextPrimary}" BorderBrush="{StaticResource BrushBorderGlass}" Padding="8,5" VerticalAlignment="Center"/>
                                            <Button Grid.Column="1" Content="Add Preset" Style="{StaticResource GlassButton}" Padding="10,5" Margin="8,0,0,0" VerticalAlignment="Center" Click="BtnAddPreset_Click"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                                
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
